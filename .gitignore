# Compose interpolation for local and droplet secrets. Never commit.
.env

# Per-episode Listenotr intros, generated on the server when someone is listening.
# The produced station pack under frontend/public/otr/live/pack/ is static and is committed.
backend/data/otr-intros/
backend/tests/_otr_intro_cache/

__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Python bytecode
**/__pycache__/
**/*.pyc
**/*.pyo
frontend/node_modules/
frontend/dist/
desktop/node_modules/
desktop/dist/

# Crane Cab local test rig: a copy of index.html with a local three.js import
# map, so test/smoke.mjs can run where the CDN is blocked. Generated, never
# committed - the real index.html loads three from the CDN.
crane-cab-dev/.localtest/
crane-cab-dev/index.local.html
# The local-import copy the browser smoke test actually uses. test/smoke.mjs's
# header says to make one when the three.js CDN is blocked; it points at
# .localtest/, which is ignored, so a committed copy would be broken in a clone.
crane-cab-dev/local.html
crane-cab-dev/node_modules
